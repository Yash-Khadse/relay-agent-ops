# Copy to .env in repository root. No paid API is required.
RELAY_DATABASE_URL=sqlite:///./data/relay.db
RELAY_CHECKPOINT_URL=sqlite:///./data/checkpoints.db
RELAY_PROVIDER=fixture
# fixture is a deterministic integration demo, NOT live AI.
# Live: ollama, groq, gemini. Explicit model selection required.
RELAY_MODEL=
RELAY_API_KEY=
RELAY_OLLAMA_URL=http://localhost:11434/v1
RELAY_CREW_ENABLED=false
RELAY_CREW_MODEL=
# CrewAI uses the same provider/API key; CREW_MODEL optionally selects a different model.
RELAY_CORS_ORIGINS=["http://localhost:5173"]
RELAY_COOKIE_SECURE=false
RELAY_DEMO_ENABLED=true
RELAY_PUBLIC_LIVE_ENABLED=false
RELAY_MAX_EXECUTIONS=10
RELAY_GLOBAL_DAILY_EXECUTIONS=100
RELAY_SESSION_HOURS=24
RELAY_APPROVAL_HOURS=24
RELAY_MAX_RUN_SECONDS=240
RELAY_LEASE_SECONDS=300
RELAY_MAX_JOB_ATTEMPTS=3
RELAY_MAX_MODEL_CALLS=12
RELAY_MAX_INPUT_TOKENS=30000
RELAY_MAX_OUTPUT_TOKENS=12000
RELAY_MODEL_TIMEOUT_SECONDS=45
# Optional configured fallback (never enabled implicitly)
RELAY_FALLBACK_PROVIDER=
RELAY_FALLBACK_MODEL=
RELAY_FALLBACK_API_KEY=
# Cloud must use PostgreSQL for metadata AND checkpoints.
# RELAY_DATABASE_URL=postgresql+psycopg://user:password@host/relay?sslmode=require
# RELAY_CHECKPOINT_URL=postgresql://user:password@host/relay?sslmode=require
RELAY_QUEUE_MODE=database
RELAY_SQS_QUEUE_URL=
RELAY_STATIC_DIR=
# Disable third-party telemetry; application events remain locally persisted.
OTEL_SDK_DISABLED=true
CREWAI_TELEMETRY_DISABLED=true
